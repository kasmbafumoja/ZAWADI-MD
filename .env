# Nom de l’auteur / créateur
OWNER_NAME=Kasereka Mbafumoja

# Numéro WhatsApp du créateur (avec indicatif)
OWNER_NUMBER=243970639878

# Mode du bot (public, private, group, inbox)
MODE=public

# Message auto pour les statuts vus
